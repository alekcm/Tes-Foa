            <ParameterList>
                <Names>
                    <string>m_enable</string>
                    <string>m_expressions</string>
                </Names>
                <Values>
                    <anyType xsi:type="xsd:boolean">false</anyType>
                    <anyType xsi:type="hkCustomParameterList">
                        <Names>
                            <string>m_expressionsData</string>
                        </Names>
                        <Values>
                            <anyType xsi:type="ArrayOfAnyType">
                                <anyType xsi:type="hkCustomParameterList">
                                    <Names>
                                        <string>m_expression</string>
                                        <string>m_eventMode</string>
                                    </Names>
                                    <Values>
                                        <anyType xsi:type="xsd:string">IntDirection = cond( ( ( (Direction+(1/3))*3 )%3 != 2.0), 0, 1)</anyType>
                                        <anyType xsi:type="xsd:string">EVENT_MODE_SEND_ONCE</anyType>
                                    </Values>
                                </anyType>
                                <anyType xsi:type="hkCustomParameterList">
                                    <Names>
                                        <string>m_expression</string>
                                        <string>m_eventMode</string>
                                    </Names>
                                    <Values>
                                        <anyType xsi:type="xsd:string">moveStartForward if ((IntDirection == 0) &amp;&amp; (Speed &gt;= fMinSpeed))</anyType>
                                        <anyType xsi:type="xsd:string">EVENT_MODE_SEND_ON_FALSE_TO_TRUE</anyType>
                                    </Values>
                                </anyType>
                                <anyType xsi:type="hkCustomParameterList">
                                    <Names>
                                        <string>m_expression</string>
                                        <string>m_eventMode</string>
                                    </Names>
                                    <Values>
                                        <anyType xsi:type="xsd:string">moveStartBackward if ((IntDirection == 1) &amp;&amp; (Speed &gt;= fMinSpeed))</anyType>
                                        <anyType xsi:type="xsd:string">EVENT_MODE_SEND_ON_FALSE_TO_TRUE</anyType>
                                    </Values>
                                </anyType>
                            </anyType>
                        </Values>
                    </anyType>
                </Values>
            </ParameterList>
        </hkCustomModifier>
