            <Y>0</Y>
            <NodeType>Evaluate Expression Modifier</NodeType>
            <ModifierType>Evaluate Expression Modifier</ModifierType>
            <ParameterList>
                <Names>
                    <string>m_enable</string>
                    <string>m_expressions</string>
                </Names>
                <Values>
                    <anyType xsi:type="xsd:boolean">true</anyType>
                    <anyType xsi:type="hkCustomParameterList">
                        <Names>
                            <string>m_expressionsData</string>
                        </Names>
                        <Values>
                            <anyType xsi:type="ArrayOfAnyType">
                                <anyType xsi:type="hkCustomParameterList">
                                    <Names>
                                        <string>m_expression</string>
                                        <string>m_eventMode</string>
                                    </Names>
                                    <Values>
                                        <anyType xsi:type="xsd:string">turnLeft if (TurnDelta &gt; 0.1)</anyType>
                                        <anyType xsi:type="xsd:string">EVENT_MODE_SEND_ON_FALSE_TO_TRUE</anyType>
                                    </Values>
                                </anyType>
                                <anyType xsi:type="hkCustomParameterList">
                                    <Names>
                                        <string>m_expression</string>
                                        <string>m_eventMode</string>
                                    </Names>
                                    <Values>
                                        <anyType xsi:type="xsd:string">turnRight if (TurnDelta &lt; -0.1)</anyType>
                                        <anyType xsi:type="xsd:string">EVENT_MODE_SEND_ON_FALSE_TO_TRUE</anyType>
                                    </Values>
                                </anyType>
                                <anyType xsi:type="hkCustomParameterList">
                                    <Names>
                                        <string>m_expression</string>
                                        <string>m_eventMode</string>
                                    </Names>
                                    <Values>
                                        <anyType xsi:type="xsd:string">turnStop if (fabs(TurnDelta) &lt;= 0.1) </anyType>
                                        <anyType xsi:type="xsd:string">EVENT_MODE_SEND_ON_FALSE_TO_TRUE</anyType>
                                    </Values>
                                </anyType>
                                <anyType xsi:type="hkCustomParameterList">
                                    <Names>
                                        <string>m_expression</string>
                                        <string>m_eventMode</string>
                                    </Names>
                                    <Values>
                                        <anyType xsi:type="xsd:string">iSyncTurnState = TurnDelta / fabs( TurnDelta + 0.00001 ) + 1 </anyType>
                                        <anyType xsi:type="xsd:string">EVENT_MODE_SEND_ONCE</anyType>
                                    </Values>
                                </anyType>
                            </anyType>
                        </Values>
                    </anyType>
                </Values>
            </ParameterList>
        </hkCustomModifier>
    </HBT_ITEM>
