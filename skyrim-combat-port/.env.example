# Локальные пути к инструментам. Скопируй этот файл в .env и впиши свои пути.
# .env в .gitignore: не коммить его и не отправляй в чат вместе с личными путями.
# Пустое значение = "не установлено / не проверял".

# Папка с SkyrimSE.exe (обычно ...\steamapps\common\Skyrim Special Edition)
SKYRIM_DIR=

# Папка с CreationKit.exe (обычно совпадает с папкой игры)
CK_DIR=

# Папка с SSEEdit.exe
XEDIT_DIR=

# Папка с skse64_loader.exe (если SKSE установлен в папку игры — оставь пустым)
SKSE_DIR=

# Явные пути, если автоматический поиск не находит инструменты
PAPYRUS_COMPILER=
PAPYRUS_FLAGS=
PAPYRUS_SOURCE=
