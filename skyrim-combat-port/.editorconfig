root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{md,markdown}]
indent_size = 2
# В Markdown два пробела в конце строки — перенос, их нельзя удалять.
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.psc]
indent_size = 4
